#include <stdio.h>

int main() {
    int opcao;
    float temperatura, resultado;

    printf("=== Sistema de conversão de temperaturas ===\n");
    printf("Escolha a opção de conversão:\n");
    printf("1 - Celsius para Kelvin\n");
    printf("2 - Celsius para Fahrenheit\n");
    printf("3 - Kelvin para Celsius\n");
    printf("4 - Kelvin para Fahrenheit\n");
    printf("5 - Fahrenheit para Celsius\n");
    printf("6 - Fahrenheit para Kelvin\n");

    scanf("%d", &opcao);

    switch(opcao) {

        case 1:
            printf("Digite o valor em Celsius: ");
            scanf("%f", &temperatura);

            resultado = temperatura + 273.15;

            printf("%.2f Celsius equivale a %.2f Kelvin\n",
                   temperatura, resultado);
            break;

        case 2:
            printf("Digite o valor em Celsius: ");
            scanf("%f", &temperatura);

            resultado = (temperatura * 9 / 5) + 32;

            printf("%.2f Celsius equivale a %.2f Fahrenheit\n",
                   temperatura, resultado);
            break;

        case 3:
            printf("Digite o valor em Kelvin: ");
            scanf("%f", &temperatura);

            resultado = temperatura - 273.15;

            printf("%.2f Kelvin equivale a %.2f Celsius\n",
                   temperatura, resultado);
            break;

        case 4:
            printf("Digite o valor em Kelvin: ");
            scanf("%f", &temperatura);

            resultado = (temperatura - 273.15) * 9 / 5 + 32;

            printf("%.2f Kelvin equivale a %.2f Fahrenheit\n",
                   temperatura, resultado);
            break;

        case 5:
            printf("Digite o valor em Fahrenheit: ");
            scanf("%f", &temperatura);

            resultado = (temperatura - 32) * 5 / 9;

            printf("%.2f Fahrenheit equivale a %.2f Celsius\n",
                   temperatura, resultado);
            break;

        case 6:
            printf("Digite o valor em Fahrenheit: ");
            scanf("%f", &temperatura);

            resultado = (temperatura - 32) * 5 / 9 + 273.15;

            printf("%.2f Fahrenheit equivale a %.2f Kelvin\n",
                   temperatura, resultado);
            break;

        default:
            printf("Opção inválida!\n");
    }

    return 0;
}
