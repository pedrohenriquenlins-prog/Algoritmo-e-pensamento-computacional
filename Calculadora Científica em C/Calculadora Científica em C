#include <stdio.h>
#include <math.h>

/* =========================
   FUNCOES MATEMATICAS
   ========================= */

double somar(double a, double b) {
    return a + b;
}

double subtrair(double a, double b) {
    return a - b;
}

double multiplicar(double a, double b) {
    return a * b;
}

double dividir(double a, double b) {
    return a / b;
}

double potencia(double base, double expoente) {
    return pow(base, expoente);
}

double raizQuadrada(double a) {
    return sqrt(a);
}

double raizCubica(double a) {
    return cbrt(a);
}

double seno(double graus) {
    return sin(graus * M_PI / 180.0);
}

double cosseno(double graus) {
    return cos(graus * M_PI / 180.0);
}

double tangente(double graus) {
    return tan(graus * M_PI / 180.0);
}

double logNatural(double a) {
    return log(a);
}

double logBase10(double a) {
    return log10(a);
}

double valorAbsoluto(double a) {
    return fabs(a);
}

double porcentagem(double valor, double percentual) {
    return valor * percentual / 100.0;
}

double mediaAritmetica(double a, double b) {
    return (a + b) / 2.0;
}

double grausParaRadianos(double graus) {
    return graus * M_PI / 180.0;
}

double radianosParaGraus(double radianos) {
    return radianos * 180.0 / M_PI;
}

double areaCirculo(double raio) {
    return M_PI * raio * raio;
}

double areaRetangulo(double base, double altura) {
    return base * altura;
}

double hipotenusa(double cateto1, double cateto2) {
    return hypot(cateto1, cateto2);
}

/* Funcoes adicionais */

double modulo(double a, double b) {
    return fmod(a, b);
}

double fatorial(int n) {
    double resultado = 1.0;

    for (int i = 1; i <= n; i++) {
        resultado *= i;
    }

    return resultado;
}

double imc(double peso, double altura) {
    return peso / (altura * altura);
}

void mostrarMenu(void) {
    printf("\n============================================\n");
    printf("          CALCULADORA COMPLETA EM C\n");
    printf("============================================\n");
    printf(" 1  - Soma\n");
    printf(" 2  - Subtracao\n");
    printf(" 3  - Multiplicacao\n");
    printf(" 4  - Divisao\n");
    printf(" 5  - Potenciacao\n");
    printf(" 6  - Raiz quadrada\n");
    printf(" 7  - Raiz cubica\n");
    printf(" 8  - Seno\n");
    printf(" 9  - Cosseno\n");
    printf("10  - Tangente\n");
    printf("11  - Logaritmo natural (ln)\n");
    printf("12  - Logaritmo base 10\n");
    printf("13  - Valor absoluto\n");
    printf("14  - Porcentagem\n");
    printf("15  - Media aritmetica\n");
    printf("16  - Graus para radianos\n");
    printf("17  - Radianos para graus\n");
    printf("18  - Area do circulo\n");
    printf("19  - Area do retangulo\n");
    printf("20  - Hipotenusa\n");
    printf("21  - Modulo (resto decimal)\n");
    printf("22  - Fatorial\n");
    printf("23  - IMC\n");
    printf(" 0  - Sair\n");
    printf("============================================\n");
}

int main(void) {
    int opcao;
    double a, b, resultado;
    int n;

    do {
        mostrarMenu();
        printf("Escolha uma opcao: ");

        if (scanf("%d", &opcao) != 1) {
            printf("\nErro: entrada invalida. Digite um numero.\n");
            while (getchar() != '\n');
            opcao = -1;
            continue;
        }

        switch (opcao) {
            case 1:
                printf("Digite dois valores: ");
                scanf("%lf %lf", &a, &b);
                resultado = somar(a, b);
                printf("Resultado: %.2lf\n", resultado);
                break;

            case 2:
                printf("Digite dois valores: ");
                scanf("%lf %lf", &a, &b);
                resultado = subtrair(a, b);
                printf("Resultado: %.2lf\n", resultado);
                break;

            case 3:
                printf("Digite dois valores: ");
                scanf("%lf %lf", &a, &b);
                resultado = multiplicar(a, b);
                printf("Resultado: %.2lf\n", resultado);
                break;

            case 4:
                printf("Digite o dividendo: ");
                scanf("%lf", &a);
                printf("Digite o divisor: ");
                scanf("%lf", &b);

                if (b == 0) {
                    printf("Erro: nao e possivel dividir por zero.\n");
                } else {
                    resultado = dividir(a, b);
                    printf("Resultado: %.2lf\n", resultado);
                }
                break;

            case 5:
                printf("Digite a base: ");
                scanf("%lf", &a);
                printf("Digite o expoente: ");
                scanf("%lf", &b);
                resultado = potencia(a, b);
                printf("Resultado: %.2lf\n", resultado);
                break;

            case 6:
                printf("Digite um numero: ");
                scanf("%lf", &a);

                if (a < 0) {
                    printf("Erro: a raiz quadrada real nao existe para numero negativo.\n");
                } else {
                    resultado = raizQuadrada(a);
                    printf("Resultado: %.2lf\n", resultado);
                }
                break;

            case 7:
                printf("Digite um numero: ");
                scanf("%lf", &a);
                resultado = raizCubica(a);
                printf("Resultado: %.2lf\n", resultado);
                break;

            case 8:
                printf("Digite o angulo em graus: ");
                scanf("%lf", &a);
                resultado = seno(a);
                printf("Seno: %.6lf\n", resultado);
                break;

            case 9:
                printf("Digite o angulo em graus: ");
                scanf("%lf", &a);
                resultado = cosseno(a);
                printf("Cosseno: %.6lf\n", resultado);
                break;

            case 10:
                printf("Digite o angulo em graus: ");
                scanf("%lf", &a);

                if (fmod(a - 90.0, 180.0) == 0) {
                    printf("Erro: tangente indefinida para esse angulo.\n");
                } else {
                    resultado = tangente(a);
                    printf("Tangente: %.6lf\n", resultado);
                }
                break;

            case 11:
                printf("Digite um numero: ");
                scanf("%lf", &a);

                if (a <= 0) {
                    printf("Erro: o logaritmo natural exige numero maior que zero.\n");
                } else {
                    resultado = logNatural(a);
                    printf("ln(%.2lf) = %.6lf\n", a, resultado);
                }
                break;

            case 12:
                printf("Digite um numero: ");
                scanf("%lf", &a);

                if (a <= 0) {
                    printf("Erro: o logaritmo base 10 exige numero maior que zero.\n");
                } else {
                    resultado = logBase10(a);
                    printf("log10(%.2lf) = %.6lf\n", a, resultado);
                }
                break;

            case 13:
                printf("Digite um numero: ");
                scanf("%lf", &a);
                resultado = valorAbsoluto(a);
                printf("|%.2lf| = %.2lf\n", a, resultado);
                break;

            case 14:
                printf("Digite o valor: ");
                scanf("%lf", &a);
                printf("Digite a porcentagem: ");
                scanf("%lf", &b);
                resultado = porcentagem(a, b);
                printf("%.2lf%% de %.2lf = %.2lf\n", b, a, resultado);
                break;

            case 15:
                printf("Digite duas notas/valores: ");
                scanf("%lf %lf", &a, &b);
                resultado = mediaAritmetica(a, b);
                printf("Media: %.2lf\n", resultado);
                break;

            case 16:
                printf("Digite o angulo em graus: ");
                scanf("%lf", &a);
                resultado = grausParaRadianos(a);
                printf("Resultado: %.6lf radianos\n", resultado);
                break;

            case 17:
                printf("Digite o valor em radianos: ");
                scanf("%lf", &a);
                resultado = radianosParaGraus(a);
                printf("Resultado: %.6lf graus\n", resultado);
                break;

            case 18:
                printf("Digite o raio: ");
                scanf("%lf", &a);

                if (a < 0) {
                    printf("Erro: o raio nao pode ser negativo.\n");
                } else {
                    resultado = areaCirculo(a);
                    printf("Area do circulo: %.2lf\n", resultado);
                }
                break;

            case 19:
                printf("Digite a base: ");
                scanf("%lf", &a);
                printf("Digite a altura: ");
                scanf("%lf", &b);

                if (a < 0 || b < 0) {
                    printf("Erro: base e altura nao podem ser negativas.\n");
                } else {
                    resultado = areaRetangulo(a, b);
                    printf("Area do retangulo: %.2lf\n", resultado);
                }
                break;

            case 20:
                printf("Digite o primeiro cateto: ");
                scanf("%lf", &a);
                printf("Digite o segundo cateto: ");
                scanf("%lf", &b);

                if (a < 0 || b < 0) {
                    printf("Erro: os catetos nao podem ser negativos.\n");
                } else {
                    resultado = hipotenusa(a, b);
                    printf("Hipotenusa: %.2lf\n", resultado);
                }
                break;

            case 21:
                printf("Digite dois valores: ");
                scanf("%lf %lf", &a, &b);

                if (b == 0) {
                    printf("Erro: modulo por zero nao e permitido.\n");
                } else {
                    resultado = modulo(a, b);
                    printf("Resultado: %.2lf\n", resultado);
                }
                break;

            case 22:
                printf("Digite um numero inteiro nao negativo: ");
                scanf("%d", &n);

                if (n < 0) {
                    printf("Erro: fatorial nao existe para numero negativo.\n");
                } else if (n > 170) {
                    printf("Erro: valor muito grande para calculo seguro com double.\n");
                } else {
                    resultado = fatorial(n);
                    printf("%d! = %.0lf\n", n, resultado);
                }
                break;

            case 23:
                printf("Digite o peso em kg: ");
                scanf("%lf", &a);
                printf("Digite a altura em metros: ");
                scanf("%lf", &b);

                if (a <= 0 || b <= 0) {
                    printf("Erro: peso e altura devem ser maiores que zero.\n");
                } else {
                    resultado = imc(a, b);
                    printf("IMC: %.2lf\n", resultado);

                    if (resultado < 18.5) {
                        printf("Classificacao: abaixo do peso.\n");
                    } else if (resultado < 25.0) {
                        printf("Classificacao: peso normal.\n");
                    } else if (resultado < 30.0) {
                        printf("Classificacao: sobrepeso.\n");
                    } else {
                        printf("Classificacao: obesidade.\n");
                    }
                }
                break;

            case 0:
                printf("\nCalculadora encerrada. Ate mais!\n");
                break;

            default:
                printf("\nErro: opcao invalida. Escolha uma opcao do menu.\n");
        }

    } while (opcao != 0);

    return 0;
}

