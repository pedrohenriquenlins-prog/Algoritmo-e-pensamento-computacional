<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Calculadora Cientifica - Projeto"/>
        <attribute name="authors" value="Pedro Henrique"/>
        <attribute name="about" value="Calculadora com 20 operacoes, IMC e calculo de area"/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="op, i" type="Integer" array="False" size=""/>
            <declare name="a, b, result, peso, altura, imc, raio" type="Real" array="False" size=""/>
            <assign variable="op" expression="1"/>
            <while expression="op != 0">
                <output expression="&quot;=== CALCULADORA CIENTIFICA ===&quot;" newline="True"/>
                <output expression="&quot;1 Soma | 2 Subtracao | 3 Multiplicacao | 4 Divisao | 5 Potencia | 6 Modulo&quot;" newline="True"/>
                <output expression="&quot;7 Raiz | 8 Seno | 9 Cosseno | 10 Tangente | 11 Asin | 12 Acos | 13 Atan&quot;" newline="True"/>
                <output expression="&quot;14 Log10 | 15 Ln | 16 Exp | 17 Abs | 18 Int | 19 Sinal | 20 Fatorial&quot;" newline="True"/>
                <output expression="&quot;21 IMC | 22 Area do circulo&quot;" newline="True"/>
                <output expression="&quot;0 Sair&quot;" newline="True"/>
                <output expression="&quot;----------------------------------------&quot;" newline="True"/>
                <output expression="&quot;Escolha uma opcao (0 a 22):&quot;" newline="True"/>
                <input variable="op"/>

                <if expression="op &gt; 0 and op &lt;= 20">
                    <then>
                        <if expression="op &gt;= 1 and op &lt;= 6">
                            <then>
                                <output expression="&quot;Digite o valor de A:&quot;" newline="True"/>
                                <input variable="a"/>
                                <output expression="&quot;Digite o valor de B:&quot;" newline="True"/>
                                <input variable="b"/>
                                <if expression="op == 1">
                                    <then><assign variable="result" expression="a + b"/></then>
                                    <else><if expression="op == 2">
                                        <then><assign variable="result" expression="a - b"/></then>
                                        <else><if expression="op == 3">
                                            <then><assign variable="result" expression="a * b"/></then>
                                            <else><if expression="op == 4">
                                                <then><if expression="b != 0">
                                                    <then><assign variable="result" expression="a / b"/></then>
                                                    <else><output expression="&quot;ERRO: divisao por zero!&quot;" newline="True"/></else>
                                                </if></then>
                                                <else><if expression="op == 5">
                                                    <then><assign variable="result" expression="a ^ b"/></then>
                                                    <else><if expression="op == 6">
                                                        <then><if expression="b != 0">
                                                            <then><assign variable="result" expression="a % b"/></then>
                                                            <else><output expression="&quot;ERRO: modulo por zero!&quot;" newline="True"/></else>
                                                        </if></then>
                                                        <else/>
                                                    </if></else>
                                                </if></else>
                                            </if></else>
                                        </if></else>
                                    </if></else>
                                </if>
                                <output expression="&quot;Resultado: &quot; &amp; result" newline="True"/>
                            </then>
                            <else>
                                <output expression="&quot;Digite o valor de A:&quot;" newline="True"/>
                                <input variable="a"/>
                                <if expression="op == 7">
                                    <then><if expression="a &gt;= 0">
                                        <then><assign variable="result" expression="sqrt(a)"/></then>
                                        <else><output expression="&quot;ERRO: nao existe raiz real de numero negativo.&quot;" newline="True"/></else>
                                    </if></then>
                                    <else><if expression="op == 8">
                                        <then><assign variable="result" expression="sin(a)"/></then>
                                        <else><if expression="op == 9">
                                            <then><assign variable="result" expression="cos(a)"/></then>
                                            <else><if expression="op == 10">
                                                <then><assign variable="result" expression="tan(a)"/></then>
                                                <else><if expression="op == 11">
                                                    <then><if expression="a &gt;= -1 and a &lt;= 1">
                                                        <then><assign variable="result" expression="arcsin(a)"/></then>
                                                        <else><output expression="&quot;ERRO: Asin aceita valores entre -1 e 1.&quot;" newline="True"/></else>
                                                    </if></then>
                                                    <else><if expression="op == 12">
                                                        <then><if expression="a &gt;= -1 and a &lt;= 1">
                                                            <then><assign variable="result" expression="arccos(a)"/></then>
                                                            <else><output expression="&quot;ERRO: Acos aceita valores entre -1 e 1.&quot;" newline="True"/></else>
                                                        </if></then>
                                                        <else><if expression="op == 13">
                                                            <then><assign variable="result" expression="arctan(a)"/></then>
                                                            <else><if expression="op == 14">
                                                                <then><if expression="a &gt; 0">
                                                                    <then><assign variable="result" expression="log10(a)"/></then>
                                                                    <else><output expression="&quot;ERRO: Log10 exige valor maior que zero.&quot;" newline="True"/></else>
                                                                </if></then>
                                                                <else><if expression="op == 15">
                                                                    <then><if expression="a &gt; 0">
                                                                        <then><assign variable="result" expression="log(a)"/></then>
                                                                        <else><output expression="&quot;ERRO: Ln exige valor maior que zero.&quot;" newline="True"/></else>
                                                                    </if></then>
                                                                    <else><if expression="op == 16">
                                                                        <then><assign variable="result" expression="exp(a)"/></then>
                                                                        <else><if expression="op == 17">
                                                                            <then><assign variable="result" expression="abs(a)"/></then>
                                                                            <else><if expression="op == 18">
                                                                                <then><assign variable="result" expression="int(a)"/></then>
                                                                                <else><if expression="op == 19">
                                                                                    <then><assign variable="result" expression="sgn(a)"/></then>
                                                                                    <else><if expression="op == 20">
                                                                                        <then><if expression="a &gt;= 0 and a == int(a)">
                                                                                            <then><assign variable="result" expression="1"/>
                                                                                                <for variable="i" start="1" end="int(a)" direction="inc" step="1">
                                                                                                    <assign variable="result" expression="result * i"/>
                                                                                                </for>
                                                                                            </then>
                                                                                            <else><output expression="&quot;ERRO: fatorial exige inteiro nao negativo.&quot;" newline="True"/></else>
                                                                                        </if></then>
                                                                                        <else/>
                                                                                    </if></else>
                                                                                </if></else>
                                                                            </if></else>
                                                                        </if></else>
                                                                    </if></else>
                                                                </if></else>
                                                            </if></else>
                                                        </if></else>
                                                    </if></else>
                                                </if></else>
                                            </if></else>
                                        </if></else>
                                    </if></else>
                                </if>
                                <if expression="op &gt;= 7 and op &lt;= 20">
                                    <then><output expression="&quot;Resultado: &quot; &amp; result" newline="True"/></then>
                                    <else/>
                                </if>
                            </else>
                        </if>
                    </then>
                    <else>
                        <if expression="op == 21">
                            <then>
                                <output expression="&quot;Digite seu peso em kg:&quot;" newline="True"/>
                                <input variable="peso"/>
                                <output expression="&quot;Digite sua altura em metros:&quot;" newline="True"/>
                                <input variable="altura"/>
                                <if expression="peso &gt; 0 and altura &gt; 0">
                                    <then>
                                        <assign variable="imc" expression="peso / (altura * altura)"/>
                                        <output expression="&quot;Seu IMC e: &quot; &amp; imc" newline="True"/>
                                        <if expression="imc &lt; 18.5">
                                            <then><output expression="&quot;Classificacao: Abaixo do peso.&quot;" newline="True"/></then>
                                            <else><if expression="imc &lt; 25">
                                                <then><output expression="&quot;Classificacao: Peso normal.&quot;" newline="True"/></then>
                                                <else><if expression="imc &lt; 30">
                                                    <then><output expression="&quot;Classificacao: Sobrepeso.&quot;" newline="True"/></then>
                                                    <else><output expression="&quot;Classificacao: Obesidade.&quot;" newline="True"/></else>
                                                </if></else>
                                            </if></else>
                                        </if>
                                    </then>
                                    <else><output expression="&quot;ERRO: peso e altura devem ser maiores que zero.&quot;" newline="True"/></else>
                                </if>
                            </then>
                            <else><if expression="op == 22">
                                <then>
                                    <output expression="&quot;Digite o raio do circulo:&quot;" newline="True"/>
                                    <input variable="raio"/>
                                    <if expression="raio &gt;= 0">
                                        <then>
                                            <assign variable="result" expression="3.14159265358979 * raio * raio"/>
                                            <output expression="&quot;Area do circulo: &quot; &amp; result" newline="True"/>
                                        </then>
                                        <else><output expression="&quot;ERRO: o raio nao pode ser negativo.&quot;" newline="True"/></else>
                                    </if>
                                </then>
                                <else><if expression="op != 0">
                                    <then><output expression="&quot;Opcao invalida! Escolha de 0 a 22.&quot;" newline="True"/></then>
                                    <else/>
                                </if></else>
                            </if></else>
                        </if>
                    </else>
                </if>
            </while>
            <output expression="&quot;Programa encerrado. Ate mais!&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
